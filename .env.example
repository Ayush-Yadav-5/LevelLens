# GEMINI_API_KEY: Placeholder for Google Gemini AI API key.
# Client-side GenAI features in LevelLens use this key to generate stories, diagnostic remarks, and micro-activities.
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# SUPABASE: Free-tier credentials for cloud persistence (Optional).
# If not provided, LevelLens runs seamlessly in offline-first mode using local storage.
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"


# EmailJS Setup Credentials
VITE_EMAILJS_SERVICE_ID="EmailJS Service ID"
VITE_EMAILJS_TEMPLATE_ID="EmailJS Template ID"
VITE_EMAILJS_PUBLIC_KEY="Your EmailJS Public Key"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
