# ====================================================================
# LevelLens Environment Configuration Reference
# ====================================================================

# 1. SUPABASE (Frontend Public Credentials)
# Required for database persistence, real-time sync, and Google OAuth.
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# 2. GEMINI AI (Production vs Local)
# In PRODUCTION (e.g. Vercel): Set GEMINI_API_KEY as a secret environment variable.
# It powers the secure /api/gemini backend proxy without client exposure.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# In LOCAL DEV: You can optionally set VITE_GEMINI_API_KEY for local offline testing.
# In production builds, this is automatically stripped to prevent key leaks.
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 3. EMAILJS (Optional: for school registration OTP dispatch)
VITE_EMAILJS_SERVICE_ID="service_xxxxxxx"
VITE_EMAILJS_TEMPLATE_ID="template_xxxxxxx"
VITE_EMAILJS_PUBLIC_KEY="public_xxxxxxx"

# 4. HOSTED APP URL
APP_URL="https://your-app.vercel.app"
